# =============================================================================
# FINLONEXA CRM v3 — Environment Variables Configuration Template
# COPY THIS FILE TO .env.local AND FILL IN REAL VALUES. DO NOT COMMIT SECRETS.
# =============================================================================

# Public Supabase Client (Browser & Server)
# Safe for public client exposure via NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Privileged Administrative Client (Server-Only)
# NEVER expose this key to browser bundles or client-side code!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Scheduled reminders endpoint (server-only)
CRON_SECRET=replace-with-a-long-random-secret

# Application Metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME="FINLONEXA"

# Node Environment
NODE_ENV=development
